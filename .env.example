# =============================================================================
# Morvexa Nexus — Environment Variables Specification
# Copy this file to .env.local for local development. Never commit real secrets.
# =============================================================================

# 1. Supabase (PostgreSQL Database & Auth SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is STRICTLY used by trusted server actions / background workers (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Application Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000/api
# Used to build links that leave the server (password reset emails). On Vercel the
# request host is used automatically; set this only for previews or a custom domain.
MORVEXA_PUBLIC_BASE_URL=https://morvexa-sistem.vercel.app

# 2b. Customer authentication & email
# Signs the HttpOnly session cookie. REQUIRED in production: without it every
# login returns 500 rather than falling back to a guessable default.
AUTH_SESSION_SECRET=generate-with-openssl-rand-base64-48
# Transactional email. Without a key, messages are written to the server log and
# reported as NOT delivered; no reset link or API key email actually arrives.
RESEND_API_KEY=re_xxxxxxxxxxxx
MORVEXA_EMAIL_FROM=Morvexa <noreply@morvexa.ai>
# Where customer accounts are persisted when Supabase is not configured.
# Serverless filesystems are ephemeral, so production needs Supabase or a volume.
MORVEXA_DATA_DIR=

# 3. Indonesian Payment Gateway (Sandbox Mode by default)
# Provider Selection: 'midtrans' or 'xendit'
PAYMENT_PROVIDER=midtrans
PAYMENT_SANDBOX_MODE=true

# Midtrans Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx

# Xendit Configuration (Alternative)
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxx
XENDIT_CALLBACK_TOKEN=your-xendit-webhook-token

# 4. Upstream AI Providers (Optional: Server-side forward keys)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxx

# 5. Hybrid Infrastructure (Dedicated / Private Server Endpoint)
PRIVATE_SERVER_URL=http://localhost:5002

# 6. Encryption Master Key (AES-256-GCM for tenant provider credentials)
ENCRYPTION_MASTER_KEY=your-32-byte-hex-encryption-key-for-tenant-credentials

# 7. Vercel Cron Secret (Bearer token authentication for /api/cron/* triggers)
CRON_SECRET=your-secure-cron-secret-token-here
